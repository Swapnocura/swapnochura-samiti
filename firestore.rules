rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileExists() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeUser() { return profileExists() && profile().active == true; }
    function isAdmin() { return activeUser() && profile().role == 'admin'; }
    function isActiveStaff() { return activeUser() && profile().role == 'staff'; }
    function hasPermission(key) { return activeUser() && (isAdmin() || (profile().permissions != null && profile().permissions[key] == true)); }
    function productPricesMigrationComplete() {
      return exists(/databases/$(database)/documents/settings/productPricesMigration)
        && get(/databases/$(database)/documents/settings/productPricesMigration).data.completed == true;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    match /members/{id} {
      allow read, create, update: if hasPermission('members') || hasPermission('passbook') || hasPermission('collection') || hasPermission('reports') || hasPermission('statement');
      allow delete: if isAdmin();
    }

    match /counters/{id} {
      allow read, write: if isAdmin() || hasPermission('members') || hasPermission('loans');
    }

    match /savingsAccounts/{id} {
      allow read, write: if hasPermission('savingsAccount');
    }

    match /savingsTransactions/{id} {
      allow read, write: if hasPermission('deposit') || hasPermission('refund') || hasPermission('passbook') || hasPermission('reports') || hasPermission('approvals') || hasPermission('dailySheet') || hasPermission('collection') || hasPermission('members') || hasPermission('statement');
    }

    match /savingsBalances/{id} {
      allow read, write: if hasPermission('deposit') || hasPermission('refund') || hasPermission('passbook') || hasPermission('approvals') || hasPermission('reports') || hasPermission('dailySheet');
    }

    // অনুমোদন পেজ: অ্যাডমিন সব আবেদন/ফেরত-আবেদন দেখতে ও পরিচালনা করতে পারবেন।
    // স্টাফ শুধু নিজের তৈরি loanApplications দেখতে পারবেন; স্টাফের query-তে createdBy == নিজের UID দিতে হবে।
    match /refundRequests/{id} {
      allow read, write: if isAdmin() || hasPermission('refund') || hasPermission('approvals');
    }

    // পণ্যের মূল্য আলাদা productPrices সংগ্রহে থাকবে। migration সম্পূর্ণ না হওয়া পর্যন্ত স্টাফ products পড়তে পারবেন না।
    match /products/{id} {
      allow read: if isAdmin() || (productPricesMigrationComplete() && (hasPermission('products') || hasPermission('purchase') || hasPermission('sale') || hasPermission('loans')));
      allow create: if isAdmin();
      allow update: if isAdmin() || (hasPermission('products') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt', 'updatedBy']));
      allow delete: if isAdmin();
    }

    match /productPrices/{productId} {
      allow read, write: if isAdmin();
    }

    match /purchases/{id} {
      allow read: if isAdmin() || hasPermission('purchase');
      allow create, update, delete: if isAdmin();
    }

    match /sales/{id} {
      allow read: if isAdmin() || hasPermission('sale') || hasPermission('loans') || hasPermission('reports');
      allow create, update, delete: if isAdmin();
    }

    match /loans/{id} {
      allow read, write: if hasPermission('loans') || hasPermission('collection') || hasPermission('reports') || hasPermission('dailySheet') || hasPermission('members') || hasPermission('statement');
    }

    match /collections/{id} {
      allow read, write: if hasPermission('collection') || hasPermission('reports') || hasPermission('dailySheet') || hasPermission('statement') || hasPermission('members');
    }

    match /villages/{id} {
      allow read, write: if hasPermission('villages') || hasPermission('members') || hasPermission('reports');
    }

    match /productGroups/{id} {
      allow read, write: if hasPermission('productGroups') || hasPermission('products');
    }

    match /brands/{id} {
      allow read, write: if hasPermission('brands') || hasPermission('products');
    }

    match /returns/{id} {
      allow read, write: if hasPermission('returns') || hasPermission('sale') || hasPermission('reports');
    }

    match /serviceEntries/{id} {
      allow read, write: if hasPermission('service') || hasPermission('reports');
    }

    match /salarySettings/{staffId} {
      allow read, write: if hasPermission('payroll');
    }

    match /payroll/{id} {
      allow read, write: if hasPermission('payroll') || hasPermission('reports');
    }

    match /loanApplications/{id} {
      allow get: if isAdmin() || (isActiveStaff() && resource.data.createdBy == request.auth.uid);
      allow list: if isAdmin() || (isActiveStaff() && resource.data.createdBy == request.auth.uid);
      allow create: if (isActiveStaff() || isAdmin())
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberNo is string
        && request.resource.data.applicationText is string;
      allow update, delete: if isAdmin();
    }

    match /notices/{id} {
      allow read: if isAdmin() || isActiveStaff();
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn() && (isAdmin() || isActiveStaff());
      allow create, update, delete: if isAdmin();
    }

    match /staffTargets/{targetId} {
      allow read: if isAdmin() || (isActiveStaff() && resource.data.staffId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
