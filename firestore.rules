rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && profile().role == 'admin' && profile().active != false; }
    function hasPermission(key) { return signedIn() && profile().active != false && (isAdmin() || profile().permissions[key] == true); }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }
    match /members/{id} {
      allow read, create, update: if hasPermission('members') || hasPermission('passbook') || hasPermission('collection') || hasPermission('reports') || hasPermission('statement');
      allow delete: if isAdmin();
    }
    match /counters/{id} { allow read, write: if isAdmin() || hasPermission('members') || hasPermission('loans'); }
    match /savingsAccounts/{id} { allow read, write: if hasPermission('savingsAccount'); }
    match /savingsTransactions/{id} {
      allow read, write: if hasPermission('deposit') || hasPermission('refund') || hasPermission('passbook') || hasPermission('reports') || hasPermission('approvals') || hasPermission('dailySheet') || hasPermission('collection') || hasPermission('members') || hasPermission('statement');
    }
    match /savingsBalances/{id} {
      allow read, write: if hasPermission('deposit') || hasPermission('refund') || hasPermission('passbook') || hasPermission('approvals') || hasPermission('reports') || hasPermission('dailySheet');
    }
    match /refundRequests/{id} { allow read, write: if hasPermission('refund') || hasPermission('approvals'); }
    match /products/{id} { allow read: if hasPermission('products') || hasPermission('purchase') || hasPermission('sale') || hasPermission('loans'); allow write: if hasPermission('products'); }
    match /purchases/{id} { allow read, write: if hasPermission('purchase'); }
    match /sales/{id} { allow read, write: if hasPermission('sale') || hasPermission('loans') || hasPermission('reports'); }
    match /loans/{id} { allow read, write: if hasPermission('loans') || hasPermission('collection') || hasPermission('reports') || hasPermission('dailySheet') || hasPermission('members') || hasPermission('statement'); }
    match /collections/{id} { allow read, write: if hasPermission('collection') || hasPermission('reports') || hasPermission('dailySheet') || hasPermission('statement') || hasPermission('members'); }
    match /{document=**} { allow read, write: if false; }
  }
}