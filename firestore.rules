rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileExists() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeUser() { return profileExists() && profile().active != false; }
    function isAdmin() { return activeUser() && profile().role == 'admin'; }
    function isActiveStaff() { return activeUser() && profile().role == 'staff'; }
    function hasPermission(key) { return activeUser() && (isAdmin() || profile().permissions[key] == true); }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }
    match /members/{id} {
      allow read, create, update: if hasPermission('members') || hasPermission('passbook') || hasPermission('collection') || hasPermission('reports') || hasPermission('statement');
      allow delete: if isAdmin();
    }
    match /counters/{id} { allow read, write: if isAdmin() || hasPermission('members') || hasPermission('loans'); }
    match /savingsAccounts/{id} { allow read, write: if hasPermission('savingsAccount'); }
    match /savingsTransactions/{id} {
      allow read, write: if hasPermission('deposit') || hasPermission('refund') || hasPermission('passbook') || hasPermission('reports') || hasPermission('approvals') || hasPermission('dailySheet') || hasPermission('collection') || hasPermission('members') || hasPermission('statement');
    }
    match /savingsBalances/{id} {
      allow read, write: if hasPermission('deposit') || hasPermission('refund') || hasPermission('passbook') || hasPermission('approvals') || hasPermission('reports') || hasPermission('dailySheet');
    }
    match /refundRequests/{id} { allow read, write: if hasPermission('refund') || hasPermission('approvals'); }
    match /products/{id} {
      allow read: if hasPermission('products') || hasPermission('purchase') || hasPermission('sale') || hasPermission('loans');
      allow write: if hasPermission('products');
    }
    match /purchases/{id} { allow read: if isAdmin() || hasPermission('purchase'); allow create, update, delete: if isAdmin(); }
    match /sales/{id} { allow read: if hasPermission('sale') || hasPermission('loans') || hasPermission('reports') || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /loans/{id} { allow read, write: if hasPermission('loans') || hasPermission('collection') || hasPermission('reports') || hasPermission('dailySheet') || hasPermission('members') || hasPermission('statement'); }
    match /collections/{id} { allow read, write: if hasPermission('collection') || hasPermission('reports') || hasPermission('dailySheet') || hasPermission('statement') || hasPermission('members'); }
    match /villages/{id} { allow read, write: if hasPermission('villages') || hasPermission('members') || hasPermission('reports'); }
    match /productGroups/{id} { allow read, write: if hasPermission('productGroups') || hasPermission('products'); }
    match /brands/{id} { allow read, write: if hasPermission('brands') || hasPermission('products'); }
    match /returns/{id} { allow read, write: if hasPermission('returns') || hasPermission('sale') || hasPermission('reports'); }
    match /serviceEntries/{id} { allow read, write: if hasPermission('service') || hasPermission('reports'); }
    match /payroll/{id} { allow read, write: if hasPermission('payroll') || hasPermission('reports'); }

    match /loanApplications/{id} {
      allow get: if isAdmin() || (isActiveStaff() && resource.data.createdBy == request.auth.uid);
      allow list: if isAdmin() || (isActiveStaff() && resource.data.createdBy == request.auth.uid);
      allow create: if (isActiveStaff() || isAdmin())
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberNo is string
        && request.resource.data.applicationText is string;
      allow update, delete: if isAdmin();
    }
    match /notices/{id} {
      allow read: if isAdmin() || isActiveStaff();
      allow create, update, delete: if isAdmin();
    }
    match /settings/{settingId} { allow read: if signedIn() && (isAdmin() || isActiveStaff()); allow create, update, delete: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
